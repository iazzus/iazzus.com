{
  // Cloudflare Workers configuration — static assets only.
  //
  // There is no Worker script. This site is pure static files, so there is
  // no "main" field: Cloudflare serves the assets directly from its edge
  // and no code runs per request.
  //
  // "name" must match the Worker in the dashboard, otherwise `wrangler
  // deploy` creates a second Worker and the custom domain stays attached
  // to the old one. Verified against the account: this is correct.
  "name": "iazzus-com",

  // Pins the Workers runtime behaviour to a known date.
  //
  // Deliberately set in the past rather than to today. Wrangler rejects a
  // compatibility_date newer than the release it was built from, so a
  // same-day value can fail the build depending on which version npm
  // resolves. Nothing here needs recent runtime behaviour.
  "compatibility_date": "2025-06-01",

  "assets": {
    // Everything that gets served lives in public/. Deployable content and
    // project tooling are kept in separate directories on purpose: it is
    // the conventional layout, and it means nothing outside public/ can be
    // published by accident.
    "directory": "./public",

    // Serve public/404.html with a real 404 status for unmatched paths,
    // rather than an empty Cloudflare error page.
    "not_found_handling": "404-page"
  },

  // Surfaces build and request logs in the dashboard.
  "observability": {
    "enabled": true
  }
}
