# Response headers for the static assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# These rules apply to files served out of public/. They do NOT apply to
# responses the Worker generates itself, so src/index.js sets its own
# headers on the /api/contact replies.
#
# The site contains no inline <style> or executable inline <script>, so the
# CSP below needs neither 'unsafe-inline' nor nonces. If you ever add an
# inline script or style, add a hash rather than loosening the policy.
#
# form-action 'self' is what allows the contact form to post to
# /api/contact without JavaScript. connect-src 'self' allows the fetch path.
#
# Cache-Control on /assets/* is deliberately short. Filenames are not
# content-hashed (there is no build step), so a long max-age would strand
# visitors on stale CSS after an edit. Fonts are the exception: their names
# change when their contents do.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests

# Development tooling. Not deployed at all under Workers (it lives outside
# public/), but this rule stays correct if the site is ever served via Pages.
/tools/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Unlisted personal page. X-Robots-Tag is the part that actually keeps it
# out of search results - robots.txt is deliberately silent about this path,
# because a Disallow line would publish the path to anyone who reads it.
#
# This is obscurity, not access control. Anyone with the URL can still open
# it. Put Cloudflare Access in front of /frida/* for real protection.
/frida/*
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
  Referrer-Policy: no-referrer
  Cache-Control: private, no-store

/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
